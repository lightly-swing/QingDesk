<Window x:Class="QingDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观设置" Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#F6F6F6">

    <StackPanel Margin="22,18,22,18">

        <!-- 背景颜色 -->
        <TextBlock Text="背景颜色" FontSize="13" FontWeight="SemiBold" Foreground="#333"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Border x:Name="ColorPreview" Width="52" Height="28" CornerRadius="4"
                    BorderBrush="#44000000" BorderThickness="1"/>
            <Button Content="选择颜色…" Padding="14,5" Margin="10,0,0,0"
                    VerticalAlignment="Center" Cursor="Hand" Click="PickColor_Click"/>
        </StackPanel>

        <!-- 不透明度 -->
        <TextBlock Text="不透明度" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,18,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Slider x:Name="OpacitySlider" Width="230" Minimum="0" Maximum="100"
                    VerticalAlignment="Center"
                    ValueChanged="OpacitySlider_ValueChanged"/>
            <TextBlock x:Name="OpacityText" Text="40%" Width="40" Margin="8,0,0,0"
                       VerticalAlignment="Center" Foreground="#333"/>
        </StackPanel>

        <!-- 边框开关 -->
        <CheckBox x:Name="BorderCheckBox" Content="显示窗口边框"
                  FontSize="13" Foreground="#333" Margin="0,14,0,0" Cursor="Hand"
                  Checked="BorderCheckBox_Changed" Unchecked="BorderCheckBox_Changed"/>

        <!-- 效果预览：按当前颜色 + 透明度实时渲染 -->
        <TextBlock Text="效果预览" FontSize="13" FontWeight="SemiBold" Foreground="#333" Margin="0,18,0,0"/>
        <Border x:Name="EffectPreview" Height="40" CornerRadius="8" Margin="0,8,0,0"
                BorderBrush="#33000000" BorderThickness="1">
            <TextBlock Text="预览：买牛奶 / 完成周报" FontSize="12" Foreground="#222"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <TextBlock Text="提示：深色背景下待办文字（深灰）可能看不清"
                   FontSize="11" Foreground="#88888888" Margin="0,10,0,0"/>

        <!-- 按钮组 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="取消" Padding="16,5" Margin="0,0,8,0" Cursor="Hand" Click="Cancel_Click"/>
            <Button Content="保存" Padding="16,5" Cursor="Hand" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
