<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>QingDesk</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ico\QingDesk.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="ico\QingDesk.ico">
      <!-- 固定资源名，保持 TrayHelper 中的 GetManifestResourceStream("QingDesk.QingDesk.ico") 不变 -->
      <LogicalName>QingDesk.QingDesk.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
